# the throwaway inputs, ZIP outputs and probe scripts are not.
review/opus-probes/
review/opus-probes-sp/
review/ncat-crosscheck/inputs/
review/ncat-crosscheck/outputs/

# HTDP working files from ad-hoc oracle runs (interim gate 1, N1)
/in.txt
/out.txt

# Auto zone recon: large public downloads kept on disk, not in git. Each is
